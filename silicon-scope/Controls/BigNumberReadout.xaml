<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="silicon_scope.Controls.BigNumberReadout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:silicon_scope.Controls"
    xmlns:services="using:silicon_scope.Services"
    xmlns:local="using:silicon_scope.Controls">

    <Grid Padding="20"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Column label -->
        <TextBlock Grid.Row="0"
                   Text="{x:Bind Label, Mode=OneWay}"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,12" />

        <!-- Body: primary on the left, optional pinned on the right -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{x:Bind local:BigNumberReadout.PinnedWidth(IsPinnedVisible), Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <!-- Primary column -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind Primary.DisplayName, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="1"
                           Text="{x:Bind local:BigNumberReadout.FormatPercent(Primary.Cpu.Value), Mode=OneWay}"
                           Style="{StaticResource BigNumberTextBlockStyle}"
                           x:Name="PrimaryBigNumber" />

                <ProgressBar Grid.Row="2"
                             Minimum="0"
                             Maximum="100"
                             Value="{x:Bind Primary.Cpu.Value, Mode=OneWay}"
                             Height="8" />

                <TextBlock Grid.Row="3"
                           Text="{x:Bind Primary.Cpu.Subtitle, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <controls:Sparkline Grid.Row="4"
                                    Values="{x:Bind Primary.Cpu.History, Mode=OneWay}"
                                    Margin="0,8,0,0" />
            </Grid>

            <!-- Pinned column (visible only when pinned) -->
            <Grid Grid.Column="1"
                  RowSpacing="12"
                  Visibility="{x:Bind local:BigNumberReadout.BoolToVisibility(IsPinnedVisible), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind Pinned.DisplayName, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock Grid.Row="1"
                           Text="{x:Bind local:BigNumberReadout.FormatPercent(Pinned.Cpu.Value), Mode=OneWay}"
                           Style="{StaticResource BigNumberCompactTextBlockStyle}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <ProgressBar Grid.Row="2"
                             Minimum="0"
                             Maximum="100"
                             Value="{x:Bind Pinned.Cpu.Value, Mode=OneWay}"
                             Height="8"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                <TextBlock Grid.Row="3"
                           Text="{x:Bind Pinned.Cpu.Subtitle, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <controls:Sparkline Grid.Row="4"
                                    Values="{x:Bind Pinned.Cpu.History, Mode=OneWay}"
                                    Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
