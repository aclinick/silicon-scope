<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="silicon_scope.Views.ProcessPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:silicon_scope.ViewModels"
    xmlns:local="using:silicon_scope.Views">

    <Grid ColumnSpacing="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Row="0" Grid.Column="0"
                  x:Name="PrimaryPicker"
                  Header="Primary process"
                  PlaceholderText="Select a process"
                  ItemsSource="{x:Bind ViewModel.AllProcesses, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                  DisplayMemberPath="Display"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="PrimaryProcessPicker"
                  AutomationProperties.Name="Primary process picker" />

        <ComboBox Grid.Row="0" Grid.Column="1"
                  x:Name="PinnedPicker"
                  Header="Pin a second process (optional)"
                  PlaceholderText="Pin a process for A/B comparison"
                  ItemsSource="{x:Bind ViewModel.AllProcesses, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.PinnedProcess, Mode=TwoWay}"
                  DisplayMemberPath="Display"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="PinnedProcessPicker"
                  AutomationProperties.Name="Pinned process picker" />

        <StackPanel Grid.Row="0" Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom">
            <Button Command="{x:Bind ViewModel.RefreshProcessListCommand}"
                    AutomationProperties.AutomationId="RefreshProcessesButton"
                    AutomationProperties.Name="Refresh process list">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.ClearPinCommand}"
                    AutomationProperties.AutomationId="ClearPinButton"
                    AutomationProperties.Name="Clear pinned process">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE738;" FontSize="14" />
                    <TextBlock Text="Unpin" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="24">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.PrimaryTrackingSubtitle, Mode=OneWay}" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       Text="{x:Bind ViewModel.PinnedTrackingSubtitle, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
