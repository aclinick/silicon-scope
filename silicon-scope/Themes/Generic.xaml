<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:silicon_scope.Controls">

    <Style TargetType="controls:Sparkline">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="StrokeBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Sparkline">
                    <Grid x:Name="PART_Root">
                        <Polyline x:Name="PART_Polyline"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
