<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BigNumberTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DisplayTextBlockStyle}">
        <Setter Property="FontSize" Value="96" />
        <Setter Property="LineHeight" Value="104" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="BigNumberCompactTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DisplayTextBlockStyle}">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="LineHeight" Value="60" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="BigNumberProjectorTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DisplayTextBlockStyle}">
        <Setter Property="FontSize" Value="120" />
        <Setter Property="LineHeight" Value="128" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
